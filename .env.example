# Credenciales de la cámara Tapo para src/camera.py.
# Copia este archivo a .env (gitignorado) y rellena tus valores.
# NUNCA subas el .env real al repositorio.

# Cuenta de cámara creada en la app Tapo (Ajustes avanzados > Cuenta de la cámara),
# no la cuenta de TP-Link.
TAPO_IP=192.168.1.X
TAPO_USER=usuario
TAPO_PASSWORD=clave
TAPO_PORT=554
# stream1 = HD (2304x1296), stream2 = 720p (menos ancho de banda)
TAPO_STREAM=stream1

# Alternativa: URL RTSP completa (si se define, ignora las variables anteriores).
# WEAPON_RTSP_URL=rtsp://usuario:clave@192.168.1.X:554/stream1

# Webcam USB (--source webcam). MJPG permite 1080p a 30 FPS.
WEBCAM_INDEX=0
WEBCAM_WIDTH=1920
WEBCAM_HEIGHT=1080

# Fuente por defecto de stream_infer.py y capture_samples.py: tapo o webcam.
CAMERA_SOURCE=tapo
